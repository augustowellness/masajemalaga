/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Imágenes y vídeos: se guardan en el navegador 7 días (la web carga más
# rápido al volver). Si sustituyes una imagen por otra con el MISMO nombre,
# algún visitante puede seguir viendo la antigua hasta 7 días.
/rituals/*
  Cache-Control: public, max-age=604800

/servicios/*
  Cache-Control: public, max-age=604800

/video1.mp4
  Cache-Control: public, max-age=604800

/video2.mp4
  Cache-Control: public, max-age=604800

# NOTA sobre la Content-Security-Policy:
# La de arriba es deliberadamente "ligera": impide que otra web meta la tuya
# dentro de un marco (clickjacking), bloquea plugins antiguos y fuerza HTTPS,
# pero NO restringe de dónde se cargan scripts. Así no rompe el login de
# Firebase, Analytics, Clarity ni el píxel de Meta (la CSP completa anterior
# se retiró justo porque bloqueaba Firebase).
#
# Cross-Origin-Opener-Policy "same-origin-allow-popups" es el valor que
# recomienda Firebase para que el acceso con Google en ventana emergente
# siga funcionando.
